@echo off
setlocal
chcp 65001 >nul

set "ROOT=%~dp0"
if "%ROOT:~-1%"=="\" set "ROOT=%ROOT:~0,-1%"
set "SELF=%~f0"
set "TMP_SCRIPT=%TEMP%\steps_activation_embedded_%RANDOM%%RANDOM%.py"

py -3 --version >nul 2>nul
if not errorlevel 1 (
    set "PY_CMD=py -3"
) else (
    python --version >nul 2>nul
    if not errorlevel 1 (
        set "PY_CMD=python"
    ) else (
        echo Python was not found. Please install Python 3 and enable "Add Python to PATH".
        pause
        exit /b 1
    )
)

%PY_CMD% -c "import base64,pathlib,sys; data=pathlib.Path(sys.argv[1]).read_text(encoding='utf-8').rsplit('__PYTHON_BASE64_BELOW__',1)[1]; pathlib.Path(sys.argv[2]).write_bytes(base64.b64decode(''.join(data.split())))" "%SELF%" "%TMP_SCRIPT%"
if errorlevel 1 (
    echo Failed to prepare embedded Python script.
    pause
    exit /b 1
)

%PY_CMD% -c "import cv2, openpyxl, PIL" >nul 2>nul
if errorlevel 1 (
    echo Installing dependencies, please wait...
    %PY_CMD% -m pip install opencv-python openpyxl Pillow
    if errorlevel 1 (
        echo Dependency installation failed. Please check network or Python/pip.
        pause
        exit /b 1
    )
)

echo Generating Excel files under: %ROOT%
%PY_CMD% "%TMP_SCRIPT%" "%ROOT%"
set "RUN_CODE=%errorlevel%"

if exist "%TMP_SCRIPT%" del "%TMP_SCRIPT%" >nul 2>nul

if not "%RUN_CODE%"=="0" (
    echo.
    echo Failed. Please check the error message above.
    pause
    exit /b %RUN_CODE%
)

echo.
echo Done. Excel files have been generated in each data group folder.
pause
goto :eof
